# ==============================================================================
# Zk-AgriSure: Frontend Environment Configuration Template
# Duplicate this file to .env.local for local frontend development,
# or add these variables to your Vercel Project Settings > Environment Variables.
# ==============================================================================

# 1. Target Blockchain Network (Sepolia Testnet)
NEXT_PUBLIC_CHAIN_ID=11155111
NEXT_PUBLIC_CHAIN_NAME=sepolia

# 2. Sepolia JSON-RPC Endpoint (Public fallback provided, or use your Alchemy/Infura URL)
NEXT_PUBLIC_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# 3. Deployed Smart Contract Addresses on Sepolia
NEXT_PUBLIC_ESCROW_ADDRESS=0xeC99C485edb9EABb9D7C1Ad5d77882c7d066Be39
NEXT_PUBLIC_ORACLE_ADDRESS=0x40Ed7b246A48b5C68792dE5a6ee0eb46D658179D

# 4. USGS Disaster Feed Configuration (Optional - Defaults apply if omitted)
USGS_FEED_URL=https://earthquake.usgs.gov/earthquakes/feed/v1.0/summary/4.5_week.geojson
DISASTER_MIN_MAGNITUDE=5.5
DISASTER_RADIUS_DEG=0.5
