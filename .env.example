# ==============================================================================
# Zk-AgriSure: Environment Configuration Template (Root / Hardhat)
# Duplicate this file to .env and fill in your keys for Sepolia testnet deployment
# ==============================================================================

# 1. Sepolia RPC Endpoint (Alchemy, Infura, or public RPC)
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_ALCHEMY_API_KEY

# 2. Deployer Private Key (Export from MetaMask; DO NOT share or commit this)
PRIVATE_KEY=your_private_key_here

# 3. Etherscan API Key (For verifying smart contract source code on Sepolia Etherscan)
ETHERSCAN_API_KEY=your_etherscan_api_key_here

# 4. Chainlink Sepolia Network Constants (Official Sepolia Testnet)
SEPOLIA_LINK_TOKEN=0x779877A7B0D9E8603169DdbD7836e478b4624789
SEPOLIA_CHAINLINK_ORACLE=0x6090149792dAAeE9D1D568c9f9a6F6B46AA29eFD
LINK_TOKEN_ADDRESS=0x779877A7B0D9E8603169DdbD7836e478b4624789
CHAINLINK_ORACLE_ADDRESS=0x6090149792dAAeE9D1D568c9f9a6F6B46AA29eFD

# 5. Live Deployed Sepolia Smart Contract Addresses (Reference)
GROTH16_VERIFIER_ADDRESS=0x1dCEbE56A7E7CE55Ba42494F723Fd082d6b3E036
